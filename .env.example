# Cubiq Studio – Einstellungen für docker-compose.yml. Auf dem Server legt deploy/studio-server.sh die .env selbst
# an; von Hand: kopieren nach .env und ausfüllen. .env NIE committen.

# Adresse der Website (ohne / am Ende) – für Canonical-Links, Sitemap und Vorschaubilder.
SITE_URL=https://cubiq.studio

# Impressum und Datenschutzerklärung: wer die Website betreibt. Auf dem Server übernimmt das Skript diese Werte bei
# jedem Bauen aus der .env der Launcher-Website (NUXT_PUBLIC_OPERATOR_*) – dort pflegen.
OPERATOR_NAME=
# Anschrift, Zeilen mit \n getrennt, z. B. Musterstraße 1\n12345 Musterstadt
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Optional: Telefon, Vertreten durch, zuständige Datenschutz-Aufsichtsbehörde.
OPERATOR_PHONE=
OPERATOR_REPRESENTATIVE=
OPERATOR_AUTHORITY=

# Ordner für die Versionsnummern (feed.json), die das Skript morgens und abends schreibt (Server: /opt/cubiq/studio-data).
STUDIO_DATA=./data

# Ordner für Zugänge und Team-Seite des Team-Bereichs (nicht öffentlich; Server: /opt/cubiq/studio-private).
STUDIO_PRIVATE=./private

# Docker-Netz, über das cloudflared die Seite erreicht (Launcher-Website: Projekt cubiq-api, Netz tunnel).
TUNNEL_NETWORK=cubiq-api_tunnel
